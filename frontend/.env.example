# Frontend settings. Copy to .env (gitignored): cp .env.example .env
# Both values are also the built-in defaults, so the app runs without a .env too.

# Where the backend API is served.
VITE_API_BASE_URL=http://localhost:8000
# Upload limit for the browser pre-check, in MB. Must match the backend's
# MAX_UPLOAD_BYTES (10485760 = 10 MB).
VITE_MAX_UPLOAD_MB=10
