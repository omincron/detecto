# Backend settings. Copy to .env (gitignored) and adjust: cp .env.example .env
# Every value below is also the built-in default in backend/config.py, so the backend
# runs without a .env too. Real environment variables override this file.

# YOLO weights; Ultralytics downloads them on first use. yolov8n.pt is faster but
# missed the accuracy target in the evaluation (README).
MODEL_PATH=yolov8s.pt
# A detection is kept if its confidence is above this.
CONFIDENCE_THRESHOLD=0.5
# Allowed frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173
# SQLite file; relative paths resolve from the project root.
DB_PATH=./backend/detecto.db
# Upload limit in bytes (10 MB). Must match VITE_MAX_UPLOAD_MB in frontend/.env.
MAX_UPLOAD_BYTES=10485760
# Run one dummy inference at startup so the first request isn't slow.
WARMUP_MODEL=true
